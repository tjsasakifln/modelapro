# Local single-user defaults. Copy to .env (never commit .env).
# No secrets are shipped. First use creates private local credentials.

APP_NAME=CONFENGE MODELA PRO
DEBUG=false

# Bind loopback only. Do not set 0.0.0.0 unless you intentionally expose the API.
API_HOST=127.0.0.1
API_PORT=8000
API_PUBLIC_URL=http://127.0.0.1:8000

FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8501

# Explicit origins only. "*" is rejected by config validation.
CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501,http://127.0.0.1:8000,http://localhost:8000

# Redis server is optional and off by default. The Python extra is modelapro[redis].
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

LOG_LEVEL=INFO
# LOG_DIR=/absolute/private/path/logs

# C10/C11 local persistence and limits. Paths are local; create on first launch.
# Unset paths use private per-user defaults. Explicit blank DATA_DIR is invalid.
# DATA_DIR=/absolute/private/path/modelapro
# UPLOAD_DIR=/absolute/private/path/modelapro/uploads
# REPORTS_DIR=/absolute/private/path/modelapro/reports
# JOBS_DIR=/absolute/private/path/modelapro/jobs
# PROJECTS_DIR=/absolute/private/path/modelapro/projects

MAX_UPLOAD_MB=25
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_SECONDS=3600

# Empty uses private per-user credentials; it does not disable authentication.
LOCAL_AUTH_TOKEN=
LOCAL_CSRF_SECRET=
# Vendor public key and buyer entitlement; never place a private signing key here.
MODELA_LICENSE_PUBLIC_KEY=
MODELA_LICENSE_PATH=

MAX_ONE_HOT_CATEGORIES=50
